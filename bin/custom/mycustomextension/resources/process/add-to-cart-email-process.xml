<?xml version="1.0" encoding="UTF-8"?>

<process xmlns="http://www.hybris.de/xsd/processdefinition"
         name="addToCartEmailProcess"
         start="prepareAddToCartEmail"
         processClass="com.mycompany.mycustomextension.model.AddToCartEmailProcessModel">

    <action id="prepareAddToCartEmail"
            bean="prepareAddToCartEmailAction">

        <transition name="OK"
                    to="generateAddToCartEmail"/>

        <transition name="NOK"
                    to="failed"/>

    </action>

    <action id="generateAddToCartEmail"
            bean="generateAddToCartEmail">

        <transition name="OK"
                    to="sendEmail"/>

        <transition name="NOK"
                    to="failed"/>

    </action>

    <action id="sendEmail"
            bean="sendEmail">

        <transition name="OK"
                    to="success"/>

        <transition name="NOK"
                    to="failed"/>

    </action>

    <end id="success"
         state="SUCCEEDED">
        Add to cart email sent successfully.
    </end>

    <end id="failed"
         state="ERROR">
        Add to cart email failed.
    </end>

</process>