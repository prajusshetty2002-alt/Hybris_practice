    <bean id="mycustomextensionService" class="com.mycompany.mycustomextension.service.impl.DefaultMycustomextensionService">
        <!-- setter injection example -->
        <property name="modelService" ref="modelService"/>
        <property name="mediaService" ref="mediaService"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>
	<bean id="productSearchDao"
      class="com.mycompany.mycustomextension.dao.impl.DefaultProductSearchDao">
</bean>

<bean id="productSearchService"
      class="com.mycompany.mycustomextension.service.impl.DefaultProductSearchService">
    <property name="productSearchDao" ref="productSearchDao"/>
</bean>

    <bean id="myCustomProductSearchFacade"
          class="com.mycompany.mycustomextension.facade.impl.DefaultProductSearchFacade">
        <property name="productSearchService" ref="productSearchService"/>
    </bean>


    <bean id="prepareAddToCartEmailAction"
          class="com.mycompany.mycustomextension.process.actions.PrepareAddToCartEmailAction"
          parent="abstractAction"/>

<!--        <bean id="addToCartEmailHook"-->
