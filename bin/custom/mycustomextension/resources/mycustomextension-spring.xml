<!--        &lt;!&ndash; ===================================================== &ndash;&gt;-->
        <!-- EMAIL CONTEXT                                         -->
        <!-- ===================================================== -->

        <bean id="addToCartEmailContext"
              class="com.mycompany.mycustomextension.process.email.AddToCartEmailContext"
              parent="abstractEmailContext"
              scope="prototype"/>


        <!-- ===================================================== -->
        <!-- GENERATE EMAIL ACTION                                  -->
        <!-- ===================================================== -->

        <bean id="generateAddToCartEmail"
              parent="abstractGenerateEmailAction">

            <property name="frontendTemplateName"
                      value="AddToCartEmailTemplate"/>

        </bean>


        <!-- ===================================================== -->
        <!-- PROCESS DEFINITION                                    -->
        <!-- ===================================================== -->

        <bean id="addToCartEmailProcessDefinitionResource"
              class="de.hybris.platform.processengine.definition.ProcessDefinitionResource">

            <property name="resource"
                      value="classpath:/process/add-to-cart-email-process.xml"/>

        </bean>


        <!-- ===================================================== -->
        <!-- PROCESS CONTEXT RESOLUTION                             -->
        <!-- ===================================================== -->

        <bean id="addToCartEmailProcessContextStrategyMergeDirective"
              depends-on="processContextResolutionStrategyMap"
              parent="mapMergeDirective">

            <property name="key">

                <value type="java.lang.Class">
                    com.mycompany.mycustomextension.model.AddToCartEmailProcessModel
                </value>

            </property>

            <property name="value"
                      ref="storeFrontProcessContextStrategy"/>



        </bean>

    <bean id="productRatingValueProvider"
          class="com.mycompany.mycustomextension.search.provider.ProductRatingValueProvider"
          parent="abstractPropertyFieldValueProvider">

        <property name="fieldNameProvider" ref="solrFieldNameProvider"/>
        <property name="customerReviewService" ref="customerReviewService"/>

    </bean>
    <bean id="customSearchResultProductPopulator"
          class="com.mycompany.mycustomextension.search.populator.CustomSearchResultProductPopulator"/>

    <bean id="customSearchResultProductPopulatorMergeDirective"
          parent="modifyPopulatorList">

        <property name="list"
                  ref="commerceSearchResultProductConverter"/>

        <property name="add"
                  ref="customSearchResultProductPopulator"/>

    </bean>

    <bean id="dailyOrderReportDao"
          class="com.mycompany.mycustomextension.dao.impl.DefaultDailyOrderReportDao">

        <property name="flexibleSearchService"
                  ref="flexibleSearchService"/>

    </bean>


    <bean id="dailyOrderReportService"
          class="com.mycompany.mycustomextension.service.impl.DefaultDailyOrderReportService">

        <property name="dailyOrderReportDao"
                  ref="dailyOrderReportDao"/>

    </bean>

    <!-- VIP USER RAO PROVIDER -->
    <bean id="vipUserRAOProvider"
          class="com.mycompany.mycustomextension.promotion.conditions.VIPUserRAOProvider"/>

    <!-- VIP USER CONDITION TRANSLATOR -->
    <bean id="vipUserConditionTranslator"
          class="com.mycompany.mycustomextension.promotion.conditions.VIPUserConditionTranslator"/>

    <!-- Add VIP provider to existing promotion RAO providers -->
    <bean id="vipUserRAOProviderMergeDirective"
          parent="mapMergeDirective"
          depends-on="orderPromotionRaoProviders">

        <property name="key"
                  value="de.hybris.platform.core.model.order.AbstractOrderModel"/>

        <property name="value">
            <list>
                <ref bean="vipUserRAOProvider"/>
            </list>
        </property>

    </bean>
    <!-- ========================================================= -->
    <!-- PRODUCT INTERCEPTOR                                      -->
    <!-- ========================================================= -->

    <bean id="productInterceptor"
          class="com.mycompany.mycustomextension.interceptors.ProductInterceptor"/>

    <bean id="productInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">

        <property name="interceptor"
                  ref="productInterceptor"/>

        <property name="typeCode"
                  value="Product"/>

        <property name="order"
                  value="1000"/>

    </bean>
    <bean id="learningTagValueResolver"
          class="com.mycompany.mycustomextension.solr.LearningTagValueResolver"/>
    <import resource="classpath:/process/erp-order-process-spring.xml"/>

    <bean id="erpOrderPlacedEventListener"
          class="com.mycompany.mycustomextension.events.ErpOrderPlacedEventListener">

        <property name="erpOrderProcessService"
                  ref="erpOrderProcessService"/>



    </bean>
    <!-- Define your new populator bean -->
    <bean id="customProductPopulator"
          class="com.mycompany.mycustomextension.populator.CustomProductPopulator"/>

    <!-- Add it to the standard product converter -->
    <bean parent="modifyPopulatorList">
        <property name="list" ref="productConverter"/>
        <property name="add" ref="customProductPopulator"/>
    </bean>
    <!-- 1. Patch Beans -->
    <bean id="patch_10_26" class="com.mycompany.mycustomextension.setup.patches.Patch_10_26"/>
    <bean id="patch_10_27" class="com.mycompany.mycustomextension.setup.patches.Patch_10_27"/>

    <!-- 2. SystemSetup Bean -->
    <bean id="mycustomextensionSystemSetup" class="com.mycompany.mycustomextension.setup.MycustomextensionSystemSetup">
        <constructor-arg ref="mycustomextensionService"/>
        <property name="setupImpexService" ref="setupImpexService"/>
        <property name="patches">
            <list>
                <ref bean="patch_10_26"/>
                <ref bean="patch_10_27"/>
            </list>
        </property>
    </bean>

    <!-- Product Details Cache -->
    <bean id="productDetailsCache"
          class="com.mycompany.mycustomextension.cache.ProductDetailsCache"/>

    <bean id="productDetailsService"
          class="com.mycompany.mycustomextension.cache.ProductDetailsService">
        <property name="productDetailsCache" ref="productDetailsCache"/>
    </bean>

</beans>




